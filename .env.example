CITYEVENTS_ENV=local
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

POSTGRES_URL=postgres://cityevents:cityevents@localhost:5432/cityevents?sslmode=disable
RABBITMQ_URL=amqp://cityevents:cityevents@localhost:5672/
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=http://localhost:9000
SMTP_ADDR=localhost:1025
JWT_SECRET=dev-secret-change-me
JWT_ISSUER=cityevents
ACCESS_TOKEN_TTL=1h

API_GATEWAY_HTTP_ADDR=:8080
AUTH_SERVICE_HTTP_ADDR=:8081
AUTH_SERVICE_POSTGRES_URL=postgres://cityevents:cityevents@localhost:5432/cityevents?sslmode=disable
EVENT_REGISTRATION_SERVICE_HTTP_ADDR=:8082
EVENT_REGISTRATION_SERVICE_POSTGRES_URL=postgres://cityevents:cityevents@localhost:5432/cityevents?sslmode=disable
FEED_SERVICE_HTTP_ADDR=:8083
NOTIFICATION_SERVICE_HTTP_ADDR=:8084
MEDIA_SERVICE_HTTP_ADDR=:8085
MEDIA_WORKER_HTTP_ADDR=:8086
